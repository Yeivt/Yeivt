{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "types": ["@types/deno"]
  },
  "include": ["functions/**/*.ts"]
}
