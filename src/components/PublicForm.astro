<form class="public-form">
  <label for="intention-name">Nombre o alias<input id="intention-name" name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="Cómo querés que te llamemos" /></label>
  <fieldset class="intention-kind"><legend>Quiero compartir</legend><label><input type="radio" name="kind" value="petition" checked /> Una petición</label><label><input type="radio" name="kind" value="gratitude" /> Un agradecimiento</label></fieldset>
  <label for="intention-message">Tu intención<textarea id="intention-message" name="message" required minlength="10" maxlength="2000" rows="5" placeholder="¿Qué querés confiar a María?" /><small>Hasta 2.000 caracteres. Evitá datos sensibles de otras personas.</small></label>
  <div class="honeypot" aria-hidden="true"><label>No completar<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="checkbox"><input type="checkbox" name="consent" required /><span>Acepto la <a href="/privacidad/">política de privacidad</a> y el uso de mis datos para gestionar mi intención de forma privada.</span></label>
  <div class="captcha"></div><button class="button" type="submit">Enviar mi intención <span aria-hidden="true">→</span></button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
<script>import '../scripts/public-form';</script>
