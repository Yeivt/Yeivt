---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { temples } from '../content/site';
---
<Layout title="Templos marianos">
  <section class="page-heading wrap"><p class="eyebrow">Lugares de encuentro</p><h1>Templos <em>marianos.</em></h1><p class="lead">Cuatro lugares para acercarnos a María y compartir la fe en comunidad.</p></section>
  <section class="wrap page-body"><div class="temple-grid">
    {temples.map(temple => <article class="temple-card">
      <Photo id={temple.photoId} fallback="/images/templo-provisional.svg" alt={temple.name} sizes="(max-width: 650px) 90vw, 560px" />
      <div class="temple-card-body">
        <PhotoCredit id={temple.photoId} />
        <p class="eyebrow">{temple.city}</p>
        <h2>{temple.name}</h2>
        <p class="temple-description">{temple.description}</p>
        <p class="temple-address"><strong>Dirección:</strong> {temple.address}</p>
        <div class="temple-links">
          <a class="text-link" href={temple.mapUrl} target="_blank" rel="noopener noreferrer">Ver en el mapa →</a>
          <a class="text-link" href={temple.website} target="_blank" rel="noopener noreferrer">Sitio del santuario →</a>
        </div>
      </div>
    </article>)}
  </div><p class="editorial-note">Consulta el sitio de cada santuario para confirmar accesos y horarios antes de visitarlo.</p></section>
</Layout>
