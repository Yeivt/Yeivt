---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Administrar comunidad" privatePage><section class="page-heading wrap"><p class="eyebrow">Equipo responsable</p><h1>Una comunidad<br /><em>bien acompañada.</em></h1><p class="lead">Revisa las solicitudes antes de habilitar el acceso. Verifica personalmente la identidad y el ministerio de cada solicitante.</p></section><section class="wrap page-body"><div class="login-card form-card" id="admin-login"><h2>Ingresar como administrador</h2><form id="admin-login-form"><label for="admin-email">Correo electrónico<input id="admin-email" type="email" name="email" required autocomplete="email" /></label><button class="button" type="submit">Recibir enlace →</button></form><button class="button secondary" id="demo-admin" type="button" hidden>Explorar solicitudes ficticias</button><p id="admin-auth-status" role="status"></p></div><div id="admin-dashboard" hidden><div class="dashboard-toolbar"><h2>Solicitudes de acceso</h2><button class="text-button" id="admin-logout" type="button">Cerrar sesión</button></div><p id="admin-status" role="status"></p><div id="access-requests" class="intention-list"></div></div></section><script>import '../../scripts/admin';</script></Layout>
