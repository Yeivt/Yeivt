---
import Layout from '../../layouts/Layout.astro';
import { prayers } from '../../content/site';
export function getStaticPaths() { return prayers.map(prayer => ({ params: { slug: prayer.slug }, props: { prayer } })); }
const { prayer } = Astro.props;
const previous = prayers[prayer.number - 2];
const next = prayers[prayer.number];
---
<Layout title={prayer.title}>
  <section class="prayer-detail wrap"><a class="text-link" href="/#oraciones">← Todas las oraciones</a><div class="prayer-detail-grid"><figure><img src={prayer.image} width="600" height="750" alt="Ilustración provisional de María" /><figcaption>Ilustración provisional</figcaption></figure><article><p class="eyebrow">Oración 0{prayer.number} de 07 · {prayer.subtitle}</p><h1>{prayer.title}</h1><div class="reading-tools"><span>Tamaño del texto</span><button type="button" data-font="smaller" aria-label="Reducir tamaño del texto">A−</button><button type="button" data-font="larger" aria-label="Aumentar tamaño del texto">A+</button></div><p class="prayer-text">{prayer.text}</p><p class="editorial-note">Texto de ejemplo, pendiente de revisión pastoral.</p><a class="button" href="/#intenciones">Dejar una intención <span aria-hidden="true">→</span></a></article></div><nav class="prayer-pagination" aria-label="Recorrer oraciones">{previous ? <a href={`/oraciones/${previous.slug}/`}>← {previous.title}</a> : <a href="/#oraciones">← Volver a las oraciones</a>}{next ? <a href={`/oraciones/${next.slug}/`}>{next.title} →</a> : <a href="/#intenciones">Compartir una intención →</a>}</nav></section>
  <style>.prayer-text { white-space: pre-line; }</style>
  <script>
    const text = document.querySelector<HTMLElement>('.prayer-text');
    let scale = 1;
    document.querySelectorAll<HTMLButtonElement>('[data-font]').forEach(button => button.addEventListener('click', () => {
      scale = Math.min(1.6, Math.max(0.9, scale + (button.dataset.font === 'larger' ? 0.1 : -0.1)));
      if (text) text.style.fontSize = `${1.3 * scale}rem`;
    }));
  </script>
</Layout>
